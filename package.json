{
  "name": "open-bubble-tank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run test",
    "test:e2e": "bun run build && playwright test",
    "fixtures": "bun tools/visual-fixtures.ts",
    "reference": "bun tools/reference-player.ts",
    "reference:browser": "bun tools/reference-browser.ts",
    "reference:input": "node tools/reference-input.ts",
    "format": "prettier --write --ignore-unknown src tests e2e tools *.ts *.json *.mjs",
    "format:check": "prettier --check --ignore-unknown src tests e2e tools *.ts *.json *.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@ruffle-rs/ruffle": "0.7.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "bun@1.3.9"
}
