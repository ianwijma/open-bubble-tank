{
  "name": "soaptank",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run test",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:smoke": "bun run test:e2e e2e/game.spec.ts --grep 'mock path:'",
    "test:e2e:offline": "bun run test:e2e --grep 'mock|synthetic'",
    "fixtures": "bun tools/visual-fixtures.ts",
    "format": "prettier --write --ignore-unknown src tests e2e tools *.ts *.json *.mjs",
    "format:check": "prettier --check --ignore-unknown src tests e2e tools *.ts *.json *.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "bun@1.3.9"
}
